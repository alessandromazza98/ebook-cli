[Unit]
Description=Ebook CLI background worker
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ebook
Group=ebook
UMask=0077
ExecStart=/opt/ebook-cli/bin/ebook --config /etc/ebook-cli/config.json worker
Restart=on-failure
RestartSec=30
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/ebook-cli
ReadOnlyPaths=/data/downloads/books/ebook-cli
MemoryMax=768M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
