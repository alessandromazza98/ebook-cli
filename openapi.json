{
  "openapi": "3.1.0",
  "info": {
    "title": "Ebook API",
    "version": "0.3.1",
    "description": "FIRST call GET /v1/help for configuration status, workflow instructions and examples. The Kindle recipient is already configured on the server; no recipient parameter is required. Search only finds books. To start a download and automatic Kindle email, call action=request or action=select and require data.job.id before claiming a job was created. Bearer-authenticated ebook operations through an HTTPS reverse proxy or private tunnel. Keep one idempotency key per submission and reuse it after timeouts. SMTP acceptance is not confirmed Kindle delivery. Defaults: 30 requests/minute per credential role, 10 new API jobs per rolling 24 hours, 100 MiB per torrent. Poll status every 15\u201330 seconds. The owner credential alone permits retry and confirm_delivery. Sources: auto (default) searches MAM first, then guest-only Z-Library if no suitable title/author/language EPUB match exists. Set source=zlibrary to search/request Z-Library directly regardless of MAM results, or source=mam to disable fallback. Z-Library uses no account. Inspect search warnings: failed fallback does not mean a book is absent. Guest browser blocks and IP quotas are reported explicitly. Direct EPUB downloads are capped at 30 MiB. The server completes supported guest proof-of-work checks automatically using operation-local cookies; no account or browser service is required."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8791"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "security": [],
        "operationId": "liveness",
        "responses": {
          "200": {
            "description": "Process is accepting HTTP; does not check remote dependencies"
          }
        }
      }
    },
    "/v1/operations": {
      "post": {
        "operationId": "ebookOperation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Operation"
              },
              "examples": {
                "requestBook": {
                  "summary": "Submit a title for download and Kindle email",
                  "value": {
                    "action": "request",
                    "title": "Alice's Adventures in Wonderland",
                    "author": "Lewis Carroll",
                    "language": "en",
                    "idempotency_key": "example-request-alice-unique-1"
                  }
                },
                "selectRelease": {
                  "summary": "Submit a real release ID from search; mam:12345 is a placeholder",
                  "value": {
                    "action": "select",
                    "release_id": "mam:12345",
                    "language": "en",
                    "idempotency_key": "example-select-unique-1"
                  }
                },
                "listJobs": {
                  "summary": "Check access without creating a job",
                  "value": {
                    "action": "jobs"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured ebook result or failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "description": "Structured ebook result or failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "401": {
            "description": "Structured ebook result or failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "404": {
            "description": "Structured ebook result or failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "409": {
            "description": "Structured ebook result or failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "422": {
            "description": "Structured ebook result or failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit (rate_limited, Retry-After seconds), concurrency limit (busy), or persistent rolling 24-hour new-job quota (daily_quota_exceeded). Replays of existing jobs do not consume the job quota.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait when the minute rate limit is exceeded",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "500": {
            "description": "Structured ebook result or failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "502": {
            "description": "Structured ebook result or failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "408": {
            "description": "Structured ebook result or failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "403": {
            "description": "Credential does not permit this operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        },
        "summary": "Search books, submit a download-and-delivery job, or check its progress",
        "description": "Read GET /v1/help first. search, jobs and status are read-only. request automatically selects and queues a clear match, or returns clarification_required without creating a job. select queues the chosen eligible release_id returned by search. Both submission actions require idempotency_key; reuse the key and body on transport retries. The background worker automatically downloads, prepares and emails the book to the configured Kindle. No destination address or separate send operation is needed. Check data.job.id and data.job.state; HTTP 200 alone does not mean a new job was created."
      }
    },
    "/v1/help": {
      "get": {
        "operationId": "ebookHelp",
        "summary": "Read first: instructions for using the ebook service",
        "description": "Call this before requesting books. Returns Kindle-configuration status without the address, allowed actions, exact workflow and request examples, limits, and guidance for reporting failures. Read-only, authenticated, and subject to the same rate budget as operations. Performs no search, submission, download, SMTP or other dependency call.",
        "responses": {
          "401": {
            "description": "Structured ebook result or failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit (rate_limited, Retry-After seconds), concurrency limit (busy), or persistent rolling 24-hour new-job quota (daily_quota_exceeded). Replays of existing jobs do not consume the job quota.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait when the minute rate limit is exceeded",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "500": {
            "description": "Structured ebook result or failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "408": {
            "description": "Structured ebook result or failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "200": {
            "description": "Side-effect-free instructions and local configuration status; no secrets or destination email address",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Help"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "search": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "query"
        ],
        "properties": {
          "action": {
            "type": "string",
            "const": "search"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "source": {
            "type": "string",
            "enum": [
              "auto",
              "mam",
              "zlibrary"
            ],
            "default": "auto",
            "description": "auto: MAM first, then Z-Library when no suitable match exists. zlibrary: explicitly search only Z-Library regardless of MAM results. mam: MAM only. MAM errors do not trigger automatic fallback."
          },
          "author": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional author constraint; pass the book title as query.",
            "minLength": 1,
            "maxLength": 300
          },
          "language": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional language constraint; pass the book title as query."
          }
        },
        "description": "Find and cache releases only. This action NEVER downloads, sends or creates a job. To fulfill a send request, follow with select or use request. Supports optional source, author and language. Search never consumes a file download slot or starts a job. warnings lists failures of automatic fallback."
      },
      "select": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "release_id",
          "idempotency_key"
        ],
        "properties": {
          "action": {
            "type": "string",
            "const": "select"
          },
          "release_id": {
            "type": "string",
            "pattern": "^(mam:[0-9]+|zlibrary:[0-9]{1,20}:[0-9a-fA-F]{1,64})$"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Unique key for this intended submission. Reuse the same key and body after timeouts or lost responses."
          }
        },
        "description": "Start the book workflow for an eligible release returned by search or clarification candidates. Creates/reuses a job and automatically proceeds to download, preparation and Kindle email. No separate download or send action exists."
      },
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "title",
          "idempotency_key"
        ],
        "properties": {
          "action": {
            "type": "string",
            "const": "request"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "author": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 300
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Unique key for this intended submission. Reuse the same key and body after timeouts or lost responses."
          },
          "source": {
            "type": "string",
            "enum": [
              "auto",
              "mam",
              "zlibrary"
            ],
            "default": "auto",
            "description": "auto: MAM first, then Z-Library when no suitable match exists. zlibrary: explicitly search only Z-Library regardless of MAM results. mam: MAM only. MAM errors do not trigger automatic fallback."
          }
        },
        "description": "Start the book workflow from a title: automatically select a clear match and create/reuse a job, or return clarification_required. The worker handles download, EPUB preparation and email to the configured Kindle. No recipient parameter is needed. Supports optional source (auto, mam, zlibrary). source=zlibrary bypasses MAM. Search warnings are included in clarification/selection metadata. A completed search with no suitable match returns status=not_found without creating a job."
      },
      "jobs": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "const": "jobs"
          }
        },
        "description": "List existing jobs only. Does not submit a new book."
      },
      "status": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "job_id"
        ],
        "properties": {
          "action": {
            "type": "string",
            "const": "status"
          },
          "job_id": {
            "type": "string"
          }
        },
        "description": "Check an existing job by its returned job_id. Does not start or submit a book."
      },
      "retry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "job_id"
        ],
        "properties": {
          "action": {
            "type": "string",
            "const": "retry"
          },
          "job_id": {
            "type": "string"
          },
          "acknowledge_possible_duplicate": {
            "type": "boolean",
            "default": false
          }
        },
        "description": "Requires the owner credential; restricted clients receive HTTP 403."
      },
      "confirm_delivery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "job_id"
        ],
        "properties": {
          "action": {
            "type": "string",
            "const": "confirm_delivery"
          },
          "job_id": {
            "type": "string"
          }
        },
        "description": "Requires the owner credential; restricted clients receive HTTP 403."
      },
      "Operation": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/search"
          },
          {
            "$ref": "#/components/schemas/select"
          },
          {
            "$ref": "#/components/schemas/request"
          },
          {
            "$ref": "#/components/schemas/jobs"
          },
          {
            "$ref": "#/components/schemas/status"
          },
          {
            "$ref": "#/components/schemas/retry"
          },
          {
            "$ref": "#/components/schemas/confirm_delivery"
          }
        ],
        "discriminator": {
          "propertyName": "action"
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "Envelope": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "ok",
              "data"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "data": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/SearchResult"
                  },
                  {
                    "$ref": "#/components/schemas/JobResult"
                  },
                  {
                    "$ref": "#/components/schemas/JobsResult"
                  },
                  {
                    "$ref": "#/components/schemas/Clarification"
                  },
                  {
                    "$ref": "#/components/schemas/NotFound"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "ok",
              "error"
            ],
            "properties": {
              "ok": {
                "const": false
              },
              "error": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        ]
      },
      "Release": {
        "type": "object",
        "required": [
          "id",
          "title",
          "author",
          "language",
          "format",
          "size_bytes",
          "seeders",
          "restrictions",
          "eligible",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(mam:[0-9]+|zlibrary:[0-9]{1,20}:[0-9a-fA-F]{1,64})$"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "format": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "seeders": {
            "type": "integer",
            "minimum": 0,
            "description": "Torrent seeders for MAM. Always 0 for direct Z-Library downloads; this does not make them ineligible."
          },
          "restrictions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "eligible": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "enum": [
              "mam",
              "zlibrary"
            ]
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "release_id",
          "language",
          "state",
          "torrent_hash",
          "prepared_path",
          "message_id",
          "error",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "release_id": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "downloading",
              "preparing",
              "ready",
              "sending",
              "smtp_accepted",
              "send_uncertain",
              "failed",
              "existing_workflow",
              "delivered"
            ]
          },
          "torrent_hash": {
            "type": [
              "string",
              "null"
            ],
            "description": "MAM torrent info hash; null for direct Z-Library jobs."
          },
          "prepared_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "message_id": {
            "type": "string"
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Error"
              }
            ]
          },
          "updated_at": {
            "type": "integer",
            "description": "Unix timestamp of last state/progress observation"
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "required": [
          "releases",
          "reported_total",
          "truncated"
        ],
        "properties": {
          "releases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Release"
            }
          },
          "reported_total": {
            "type": "integer",
            "description": "Sum of the providers' reported totals; may include unrelated or ineligible books."
          },
          "truncated": {
            "type": "boolean"
          },
          "sources_searched": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mam",
                "zlibrary"
              ]
            },
            "description": "Providers successfully searched."
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchWarning"
            },
            "description": "Automatic fallback could not complete; do not report this as no Z-Library match."
          },
          "fallback_reason": {
            "type": "string",
            "const": "no_suitable_mam_match"
          }
        }
      },
      "JobResult": {
        "type": "object",
        "required": [
          "job"
        ],
        "properties": {
          "job": {
            "$ref": "#/components/schemas/Job"
          },
          "selection": {
            "type": "object"
          }
        }
      },
      "JobsResult": {
        "type": "object",
        "required": [
          "jobs"
        ],
        "properties": {
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          }
        }
      },
      "Clarification": {
        "type": "object",
        "required": [
          "status",
          "reason",
          "candidates"
        ],
        "properties": {
          "status": {
            "const": "clarification_required"
          },
          "reason": {
            "type": "string",
            "description": "search_incomplete means an attempted fallback failed; inspect warnings. Other reasons describe matching ambiguity."
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "release",
                "score"
              ],
              "properties": {
                "release": {
                  "$ref": "#/components/schemas/Release"
                },
                "score": {
                  "type": "integer"
                }
              }
            }
          },
          "sources_searched": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mam",
                "zlibrary"
              ]
            },
            "description": "Providers successfully searched."
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchWarning"
            },
            "description": "Automatic fallback could not complete; do not report this as no Z-Library match."
          }
        }
      },
      "Help": {
        "type": "object",
        "required": [
          "api_version",
          "purpose",
          "delivery",
          "authentication",
          "operations",
          "workflow",
          "http",
          "examples",
          "idempotency",
          "states",
          "limits",
          "errors",
          "sources"
        ],
        "properties": {
          "api_version": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "delivery": {
            "type": "object",
            "required": [
              "configured",
              "destination",
              "destination_address_required_from_caller",
              "instruction"
            ],
            "properties": {
              "configured": {
                "type": "boolean",
                "description": "Local settings are present; no remote connectivity or delivery test is performed."
              },
              "destination": {
                "type": "string",
                "const": "server_configured_kindle"
              },
              "destination_address_required_from_caller": {
                "type": "boolean",
                "const": false
              },
              "instruction": {
                "type": "string"
              }
            }
          },
          "authentication": {
            "type": "object",
            "required": [
              "scheme",
              "credential_role",
              "allowed_actions"
            ],
            "properties": {
              "scheme": {
                "const": "Bearer"
              },
              "credential_role": {
                "type": "string",
                "enum": [
                  "owner",
                  "client"
                ]
              },
              "allowed_actions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "operations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "workflow": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "http": {
            "type": "object",
            "required": [
              "method",
              "path",
              "content_type",
              "client_timeout_seconds"
            ],
            "properties": {
              "method": {
                "const": "POST"
              },
              "path": {
                "const": "/v1/operations"
              },
              "content_type": {
                "const": "application/json"
              },
              "client_timeout_seconds": {
                "type": "integer"
              }
            }
          },
          "examples": {
            "type": "object",
            "description": "Illustrative bodies only; replace uppercase placeholders and never submit example books unless requested.",
            "additionalProperties": {
              "type": "object"
            }
          },
          "idempotency": {
            "type": "string"
          },
          "states": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "limits": {
            "type": "object",
            "required": [
              "requests_per_minute",
              "new_jobs_per_rolling_24_hours",
              "max_torrent_bytes",
              "max_request_bytes"
            ],
            "properties": {
              "requests_per_minute": {
                "type": "integer",
                "minimum": 1
              },
              "new_jobs_per_rolling_24_hours": {
                "type": "integer",
                "minimum": 1
              },
              "max_torrent_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "max_request_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "max_epub_bytes": {
                "type": "integer",
                "const": 31457280
              }
            }
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "sources": {
            "type": "object",
            "description": "Source selection policy and guest-only Z-Library configuration/availability. Contains no credentials."
          }
        }
      },
      "SearchWarning": {
        "type": "object",
        "required": [
          "source",
          "error"
        ],
        "properties": {
          "source": {
            "const": "zlibrary"
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        }
      },
      "NotFound": {
        "type": "object",
        "required": [
          "status",
          "reason",
          "candidates"
        ],
        "properties": {
          "status": {
            "const": "not_found"
          },
          "reason": {
            "const": "no_suitable_title_author_language_match"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "release",
                "score"
              ],
              "properties": {
                "release": {
                  "$ref": "#/components/schemas/Release"
                },
                "score": {
                  "type": "integer"
                }
              }
            }
          },
          "sources_searched": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mam",
                "zlibrary"
              ]
            },
            "description": "Providers successfully searched."
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchWarning"
            },
            "description": "Automatic fallback could not complete; do not report this as no Z-Library match."
          }
        },
        "description": "Successfully searched sources had no suitable title/author/language EPUB match. No job was created. Candidates are alternatives, not confirmed matches. Failed fallback instead returns clarification_required with reason=search_incomplete and warnings."
      }
    }
  }
}
